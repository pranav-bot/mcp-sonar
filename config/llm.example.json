{
  "default": "anthropic-dev",
  "configs": {
    "anthropic-dev": {
      "provider": "anthropic",
      "model": "claude-sonnet-4-20250514",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "openai-dev": {
      "provider": "openai",
      "model": "gpt-4o",
      "api_key_env": "OPENAI_API_KEY"
    },
    "vertex-gemini": {
      "provider": "vertexai",
      "model": "gemini-2.5-flash",
      "project_env": "GOOGLE_CLOUD_PROJECT",
      "location": "us-central1"
    },
    "vertex-claude": {
      "provider": "anthropic-vertex",
      "model": "claude-sonnet-4-20250514",
      "project_env": "GOOGLE_CLOUD_PROJECT",
      "location": "us-east5"
    },
    "maas": {
      "provider": "maas",
      "model": "your-model-id",
      "base_url_env": "MAAS_BASE_URL",
      "api_key_env": "MAAS_API_KEY",
      "verify_ssl_env": "MAAS_VERIFY_SSL",
      "rate_limit_per_minute": 60
    }
  }
}
